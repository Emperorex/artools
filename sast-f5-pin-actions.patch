diff --git a/.github/workflows/release_tool.yaml b/.github/workflows/release_tool.yaml
index 59cb2fd..67ad841 100644
--- a/.github/workflows/release_tool.yaml
+++ b/.github/workflows/release_tool.yaml
@@ -40,16 +40,19 @@ jobs:
       - name: Checkout repository
         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
 
+      # Pinned to a commit like every other action here: this job can mint
+      # provenance attestations, so nothing a tag owner changes may run in
+      # it. v1 at this commit is the same code as @stable; the toolchain is
+      # named explicitly because only the stable branch defaults it.
       - name: Setup Rust toolchain
-        uses: dtolnay/rust-toolchain@stable
+        uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
         with:
+          toolchain: stable
           targets: ${{ matrix.target }}
 
-      # Dynamic dependency caching based on user-selected tool path
-      - name: Rust Cache
-        uses: swatinem/rust-cache@v2
-        with:
-          workspaces: "."
+      # No build cache in the release job, on purpose: a cache restored from
+      # another workflow run could feed tampered build outputs into a binary
+      # that then gets a valid attestation. Release builds always start clean.
 
       # musl-tools package required to produce statically linked Linux binaries
