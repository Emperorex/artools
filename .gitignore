# .gitignore for dnipro-tech
# Add patterns for files and directories that should not be committed.
# Customize the sections below as needed for your project.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnail cache
Thumbs.db

# Node dependencies
node_modules/

# Build outputs
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
.pids
*.pid
*.seed
*.pid.lock

# dotenv environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Coverage / test output
.coverage
coverage/

# IDEs and editors
.idea/
*.iml
.vscode/

# JetBrains project files
out/

# Other
*.swp
*.swo

# End of .gitignore
